{
  "uid": "arb-bot-fleet",
  "title": "Arb Bot — Fleet Comparison",
  "description": "All bot instances overlaid for cross-developer comparison",
  "tags": ["arbitrage", "fleet"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "Geyser Ingestion",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Geyser Account Update Rate",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "pointSize": 5, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "sum by (exported_instance) (rate(arbitrage_arbitrage_geyser_update_count_total{update_type=\"Account\"}[$__rate_interval]))", "legendFormat": "{{exported_instance}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Relevant Transaction Rate",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "sum by (exported_instance) (rate(arbitrage_arbitrage_geyser_update_count_total{update_type=\"Transaction\", cared_about=\"true\"}[$__rate_interval]))", "legendFormat": "{{exported_instance}}" }
      ]
    },
    {
      "type": "row",
      "title": "Quoting — p50",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Quote Process Duration p50",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le, exported_instance) (rate(arbitrage_arbitrage_quote_process_duration_ms_bucket[$__rate_interval])))", "legendFormat": "{{exported_instance}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Quote Process Duration p99",
