      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le, exported_instance) (rate(arbitrage_arbitrage_quote_process_duration_ms_bucket[$__rate_interval])))", "legendFormat": "{{exported_instance}}" }
