{
  "uid": "arb-bot-developer-with-tx-success",
  "title": "Arb Bot - Developer with Tx Success",
  "description": "Single developer arbitrage bot performance dashboard with additional TX Success",
  "tags": ["arbitrage", "developer", "transactions"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "developer",
        "type": "query",
        "label": "Developer",
        "datasource": { "uid": "DS_PROMETHEUS" },
        "query": "label_values(arbitrage_target_info, developer_name)",
        "refresh": 2,
        "sort": 1,
        "current": {},
        "includeAll": false,
        "multi": false
      },
      {
        "name": "instance",
        "type": "query",
        "label": "Instance",
        "datasource": { "uid": "DS_PROMETHEUS" },
        "query": "label_values(arbitrage_target_info{developer_name=\"$developer\"}, exported_instance)",
        "refresh": 2,
        "sort": 1,
        "current": {},
        "includeAll": false,
        "multi": false,
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Geyser Account Updates / sec",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "options": { "colorMode": "background_solid", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 100}, {"color": "green", "value": 1000}] } } },
      "targets": [{ "refId": "A", "expr": "sum(rate(arbitrage_arbitrage_geyser_update_count_total{exported_instance=\"$instance\", update_type=\"Account\"}[$__rate_interval]))" }]
    },
    {
      "type": "stat",
      "title": "Winning Arbs (landed success)",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "options": { "colorMode": "background_solid", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "dark-red", "value": null}, {"color": "green", "value": 1}] } } },
      "targets": [{ "refId": "A", "expr": "sum(arbitrage_arbitrage_tx_landed_count_total{exported_instance=\"$instance\", status=\"success\"})" }]
    },
    {
      "type": "stat",
      "title": "Quote Latency p99",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "options": { "colorMode": "background_solid", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 20}] } } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(arbitrage_arbitrage_quote_process_duration_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))" }]
    },
    {
      "type": "stat",
      "title": "Executor Latency p99",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "options": { "colorMode": "background_solid", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 200}] } } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(arbitrage_arbitrage_executor_latency_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))" }]
    },

    {
      "type": "row",
      "title": "TX Lifecycle — Success vs Failure",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Attempted / min",
      "description": "Total arb attempts entering the executor",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 6 },
      "options": { "colorMode": "background_solid", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "cpm", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "blue", "value": null}] } } },
      "targets": [{ "refId": "A", "expr": "sum(rate(arbitrage_arbitrage_tx_attempted_count_total{exported_instance=\"$instance\"}[$__rate_interval])) * 60" }]
    },
    {
      "type": "stat",
      "title": "Sent / min",
      "description": "Transactions where at least one sender acknowledged",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 6 },
      "options": { "colorMode": "background_solid", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "cpm", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "purple", "value": null}] } } },
      "targets": [{ "refId": "A", "expr": "sum(rate(arbitrage_arbitrage_tx_sent_count_total{exported_instance=\"$instance\"}[$__rate_interval])) * 60" }]
    },
    {
      "type": "stat",
      "title": "Landed Success / min",
      "description": "On-chain successful arbs",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 6 },
      "options": { "colorMode": "background_solid", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "cpm", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "green", "value": null}] } } },
      "targets": [{ "refId": "A", "expr": "sum(rate(arbitrage_arbitrage_tx_landed_count_total{exported_instance=\"$instance\", status=\"success\"}[$__rate_interval])) * 60" }]
    },
    {
      "type": "stat",
      "title": "Landed Failed / min",
      "description": "On-chain failed arbs (contract error, etc.)",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 6 },
      "options": { "colorMode": "background_solid", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "cpm", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.1}] } } },
      "targets": [{ "refId": "A", "expr": "sum(rate(arbitrage_arbitrage_tx_landed_count_total{exported_instance=\"$instance\", status=\"failure\"}[$__rate_interval])) * 60" }]
    },
    {
      "type": "gauge",
      "title": "Win Rate (Success / Landed)",
      "description": "Ratio of successful landed arbs to all landed arbs",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 6 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true, "showThresholdLabels": false },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.3}, {"color": "green", "value": 0.6}] } } },
      "targets": [{ "refId": "A", "expr": "sum(rate(arbitrage_arbitrage_tx_landed_count_total{exported_instance=\"$instance\", status=\"success\"}[$__rate_interval])) / sum(rate(arbitrage_arbitrage_tx_landed_count_total{exported_instance=\"$instance\"}[$__rate_interval]))" }]
    },
    {
      "type": "gauge",
      "title": "Attempt → Success Rate",
      "description": "Ratio of winning arbs to total attempts (end-to-end efficiency)",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 6 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true, "showThresholdLabels": false },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.01}, {"color": "green", "value": 0.05}] } } },
      "targets": [{ "refId": "A", "expr": "sum(rate(arbitrage_arbitrage_tx_landed_count_total{exported_instance=\"$instance\", status=\"success\"}[$__rate_interval])) / sum(rate(arbitrage_arbitrage_tx_attempted_count_total{exported_instance=\"$instance\"}[$__rate_interval]))" }]
    },
    {
      "type": "timeseries",
      "title": "Wins vs Attempts vs Failures (over time)",
      "description": "Overlay of winning arbs, total attempts, and on-chain failures",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "cpm", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Wins (landed success)" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Failed (landed failure)" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Attempted" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }, { "id": "custom.fillOpacity", "value": 5 }] },
          { "matcher": { "id": "byName", "options": "Sent" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(arbitrage_arbitrage_tx_attempted_count_total{exported_instance=\"$instance\"}[$__rate_interval])) * 60", "legendFormat": "Attempted" },
        { "refId": "B", "expr": "sum(rate(arbitrage_arbitrage_tx_sent_count_total{exported_instance=\"$instance\"}[$__rate_interval])) * 60", "legendFormat": "Sent" },
        { "refId": "C", "expr": "sum(rate(arbitrage_arbitrage_tx_landed_count_total{exported_instance=\"$instance\", status=\"success\"}[$__rate_interval])) * 60", "legendFormat": "Wins (landed success)" },
        { "refId": "D", "expr": "sum(rate(arbitrage_arbitrage_tx_landed_count_total{exported_instance=\"$instance\", status=\"failure\"}[$__rate_interval])) * 60", "legendFormat": "Failed (landed failure)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Drop Reasons (stacked)",
      "description": "Why attempts were dropped before reaching the network",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "cpm", "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "stacking": { "mode": "normal" }, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "mean"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (reason) (rate(arbitrage_arbitrage_tx_attempt_dropped_count_total{exported_instance=\"$instance\"}[$__rate_interval])) * 60", "legendFormat": "{{reason}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Sender ACKs by Type",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "cpm", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "mean"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (sender_type) (rate(arbitrage_arbitrage_tx_sender_ack_count_total{exported_instance=\"$instance\"}[$__rate_interval])) * 60", "legendFormat": "{{sender_type}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Attempted by Path (regular vs high_value)",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "cpm", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (path) (rate(arbitrage_arbitrage_tx_attempted_count_total{exported_instance=\"$instance\"}[$__rate_interval])) * 60", "legendFormat": "{{path}}" }
      ]
    },

    {
      "type": "row",
      "title": "Geyser Ingestion",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Geyser Update Rate by Type",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "pointSize": 5, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "sum by (update_type) (rate(arbitrage_arbitrage_geyser_update_count_total{exported_instance=\"$instance\", cared_about=\"\"}[$__rate_interval]))", "legendFormat": "{{update_type}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Transaction Updates (cared about vs ignored)",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "rate(arbitrage_arbitrage_geyser_update_count_total{exported_instance=\"$instance\", update_type=\"Transaction\", cared_about=\"true\"}[$__rate_interval])", "legendFormat": "Relevant txs" },
        { "refId": "B", "expr": "rate(arbitrage_arbitrage_geyser_update_count_total{exported_instance=\"$instance\", update_type=\"Transaction\", cared_about=\"false\"}[$__rate_interval])", "legendFormat": "Ignored txs" }
      ]
    },
    {
      "type": "row",
      "title": "Quoting",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Quote Process Duration",
      "description": "End-to-end quoting pipeline latency",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(arbitrage_arbitrage_quote_process_duration_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(arbitrage_arbitrage_quote_process_duration_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(arbitrage_arbitrage_quote_process_duration_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Individual Quote Duration",
      "description": "Per-quote calculation latency",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(arbitrage_arbitrage_quote_individual_duration_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(arbitrage_arbitrage_quote_individual_duration_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(arbitrage_arbitrage_quote_individual_duration_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "row",
      "title": "Search & Execution",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Search Duration",
      "description": "Time to find the best arbitrage route",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 45 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(arbitrage_arbitrage_search_duration_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(arbitrage_arbitrage_search_duration_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(arbitrage_arbitrage_search_duration_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Executor Latency",
      "description": "End-to-end latency from Geyser update to transaction execution",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 45 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(arbitrage_arbitrage_executor_latency_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(arbitrage_arbitrage_executor_latency_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(arbitrage_arbitrage_executor_latency_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "row",
      "title": "Pool Updates",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 53 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Pool Update Duration",
      "description": "Time to update pool state from a transaction",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 54 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(arbitrage_arbitrage_pool_update_duration_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(arbitrage_arbitrage_pool_update_duration_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(arbitrage_arbitrage_pool_update_duration_ms_bucket{exported_instance=\"$instance\"}[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pool Update Rate",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 54 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(arbitrage_arbitrage_pool_update_duration_ms_count{exported_instance=\"$instance\"}[$__rate_interval]))", "legendFormat": "updates/sec" }
      ]
    },
    {
      "type": "row",
      "title": "Infrastructure",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 62 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "RPC Latency",
      "description": "Latency of RPC calls for dynamic pool loading",
      "datasource": { "uid": "DS_PROMETHEUS" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 63 },
